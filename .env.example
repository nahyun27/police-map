# 사이트 공개 주소 (메타태그·sitemap 기준 URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 검색엔진 색인 허용 여부. 기본값(미설정)은 색인 차단(noindex).
# 실제 데이터로 정식 오픈할 때만 true 로 설정한다.
NEXT_PUBLIC_ALLOW_INDEXING=false

# 백엔드 API 주소. 로컬 개발 시 backend/README.md 의 안내대로 8001 포트에서 uvicorn 을 띄운다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
